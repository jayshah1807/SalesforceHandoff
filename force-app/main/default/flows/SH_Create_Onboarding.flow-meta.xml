<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>Already_Exists</name>
        <label>Request already exists?</label>
        <locationX>176</locationX>
        <locationY>302</locationY>
        <defaultConnector>
            <targetReference>Get_Triage_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create request</defaultConnectorLabel>
        <rules>
            <name>Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Preserve existing request</label>
        </rules>
    </decisions>
    <description>For opted-in won opportunities, create one onboarding request. Unique source key prevents duplicates. Existing records are not overwritten. Unhandled create failures roll back the originating save.</description>
    <environments>Default</environments>
    <formulas>
        <name>TargetOwner</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SH_CSM__c}), {!Get_Triage_Queue.Id}, {!$Record.SH_CSM__c})</expression>
    </formulas>
    <formulas>
        <name>InitialStatus</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SH_CSM__c}), "Needs Triage", "Ready")</expression>
    </formulas>
    <formulas>
        <name>RequiresTriage</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!$Record.SH_CSM__c})</expression>
    </formulas>
    <interviewLabel>Create Onboarding {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Handoff: Create Onboarding</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Request</name>
        <label>Create onboarding request</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity_Key__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>TargetOwner</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Email__c</field>
            <value>
                <elementReference>$Record.SH_Contact_Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Requested_Start__c</field>
            <value>
                <elementReference>$Record.SH_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Success_Criteria__c</field>
            <value>
                <elementReference>$Record.SH_Success_Criteria__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>InitialStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Needs_Triage__c</field>
            <value>
                <elementReference>RequiresTriage</elementReference>
            </value>
        </inputAssignments>
        <object>SH_Onboarding__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing</name>
        <label>Find request for this opportunity</label>
        <locationX>176</locationX>
        <locationY>194</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Already_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SH_Onboarding__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Triage_Queue</name>
        <label>Find onboarding triage queue</label>
        <locationX>176</locationX>
        <locationY>410</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Request</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SH_Onboarding_Triage</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SH_Enabled__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsWon</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>